def compute_total(quantity, price):
    total = quantity * price
    if total > 10000:
        total = total * 0.90
    return total
total_ext_price = 0

while True:
    quantity = int(input("Enter quantity (0 to stop): "))
    if quantity == 0:
        break
    price = float(input("Enter price: "))

    total = compute_total(quantity, price)

    print("Quantity:", quantity)
    print("Price: $", format(price, ".2f"))
    print("Total: $", format(total, ".2f"))

    total_ext_price += total

print("Total Extended Price: $", format(total_ext_price, ".2f"))
