class Employee:
    def __init__(self, first_name, last_name, salary):
        self.first_name = first_name
        self.last_name = last_name
        self.salary = salary

    def calculate_bonus(self, bonus_rate):
        return self.salary * bonus_rate


employee = Employee("Alex", "Johnson", 50000)
print("Employee:", employee.first_name, employee.last_name)
print(f"Salary: ${employee.salary:,.2f}")
bonus_rate = float(input("Enter bonus rate as a decimal (example: 0.10 for 10%): "))
bonus = employee.calculate_bonus(bonus_rate)
print(f"Employee bonus: ${bonus:,.2f}")
